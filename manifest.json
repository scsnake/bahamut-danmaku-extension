{
  "manifest_version": 3,
  "name": "Bahamut Danmaku Enhancer",
  "version": "1.0.0",
  "description": "Bypasses the 3000-item limit for Bahamut Anime Crazy danmaku and uses AI to filter spoilers and inappropriate content.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://ani.gamer.com.tw/*",
    "*://api.gamer.com.tw/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://ani.gamer.com.tw/animeVideo.php*"],
      "css": ["content.css", "bookmarks/content-bookmarks.css"],
      "js": ["bookmarks/common.js", "bookmarks/content-bookmarks.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
