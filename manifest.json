{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "default_locale": "zh_TW",
  "version": "1.0.0",
  "description": "__MSG_appDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://ani.gamer.com.tw/*",
    "*://api.gamer.com.tw/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://ani.gamer.com.tw/animeVideo.php*"],
      "css": ["content.css", "bookmarks/content-bookmarks.css"],
      "js": ["i18n.js", "bookmarks/common.js", "bookmarks/content-bookmarks.js", "density.js", "opskip.js", "infomode.js", "opaudio.js", "opreport.js", "audioprobe.js", "agegate.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
