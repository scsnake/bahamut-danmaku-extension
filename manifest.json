{
  "manifest_version": 3,
  "name": "Bahamut Danmaku Enhancer",
  "version": "1.0.0",
  "description": "Danmaku layer for Bahamut Anime Crazy that matches the official one, filters spoilers and inappropriate content with local AI, and adds scene bookmarks and a density curve.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://ani.gamer.com.tw/*",
    "*://api.gamer.com.tw/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://ani.gamer.com.tw/animeVideo.php*"],
      "css": ["content.css", "bookmarks/content-bookmarks.css"],
      "js": ["bookmarks/common.js", "bookmarks/content-bookmarks.js", "density.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
